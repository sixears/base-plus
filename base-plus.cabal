name:                base-plus

-- PVP summary:      +-+------- breaking API changes
--                   | | +----- non-breaking API additions
--                   | | | +--- code changes with no API change
version:             0.0.3.0
synopsis:            my additions to the base package
description:         my additions to the base package
cabal-version:       >= 1.10
license:             MIT
license-file:        LICENSE
author:              Martyn J. Pearce
maintainer:          haskell@sixears.com
build-type:          Simple
library
  ghc-options:        -O2 -W -Wall -fhelpful-errors
  exposed-modules:    BasePlus
                    , BasePlus.Async
                    , BasePlus.EMonad
                    , BasePlus.List
                    , BasePlus.Name
                    , BasePlus.New
                    , BasePlus.StdErr
                    , BasePlus.UTCTime
  other-modules:
  default-extensions: ExistentialQuantification
                    , FlexibleContexts
                    , FlexibleInstances
                    , GeneralizedNewtypeDeriving
                    , LambdaCase
                    , MultiParamTypeClasses
                    , PatternSynonyms
                    , ScopedTypeVariables
                    , TypeSynonymInstances
                    , UnicodeSyntax

  build-depends:      async, base, lens, text, time

                    , base0         >= 0.0.5.0
                    , monaderror-io >= 1.2.8.0
                    , more-unicode  >= 0.0.27.0

  hs-source-dirs:      src
  default-language:    Haskell2010

--------------------------------------------------------------------------------
